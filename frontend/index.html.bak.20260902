<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>小石榴学习管理台</title>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --bg: #f5f5f0;
            --card: #ffffff;
            --border: #e8e4dc;
            --text: #2d2d2d;
            --text-secondary: #6b6b6b;
            --text-muted: #999999;
            --primary: #4a7c59;
            --primary-light: #e8f0eb;
            --accent: #d4a574;
            --accent-light: #faf3eb;
            --danger: #c0392b;
            --danger-light: #fceae8;
            --info: #5b8fa8;
            --info-light: #e8f2f7;
            --purple: #7c6da0;
            --purple-light: #f0edf5;
            --sidebar-bg: #2c3e2d;
            --sidebar-text: #b8c9b9;
            --sidebar-active: #4a7c59;
            --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
            --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
            --radius: 12px;
            --radius-sm: 8px;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            line-height: 1.5;
        }

        /* ========== 登录页 ========== */
        .login-page {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #e8f0eb 0%, #faf3eb 50%, #f5f0e8 100%);
        }

        .login-card {
            background: white;
            border-radius: 20px;
            padding: 48px 40px;
            width: 400px;
            box-shadow: var(--shadow-md);
        }

        .login-card .logo {
            text-align: center;
            margin-bottom: 32px;
        }

        .login-card .logo-icon {
            width: 64px;
            height: 64px;
            background: var(--primary-light);
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-bottom: 16px;
        }

        .login-card h1 {
            font-size: 22px;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 4px;
        }

        .login-card .subtitle {
            font-size: 14px;
            color: var(--text-muted);
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-size: 15px;
            transition: all 0.2s;
            background: #fafafa;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 3px rgba(74, 124, 89, 0.1);
        }

        .btn-primary {
            width: 100%;
            padding: 14px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary:hover {
            background: #3d6a4a;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(74, 124, 89, 0.3);
        }

        .login-error {
            color: var(--danger);
            font-size: 13px;
            margin-top: 12px;
            text-align: center;
            display: none;
        }

        /* ========== 主布局 ========== */
        .app-layout {
            display: none;
            min-height: 100vh;
        }

        .app-layout.active {
            display: flex;
        }

        /* ========== 侧边栏 ========== */
        .sidebar {
            width: 240px;
            background: var(--sidebar-bg);
            color: var(--sidebar-text);
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 24px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .sidebar-brand h2 {
            font-size: 16px;
            font-weight: 600;
            color: white;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-brand .brand-icon {
            width: 32px;
            height: 32px;
            background: var(--primary);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .sidebar-user {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            background: var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            color: white;
            font-weight: 600;
        }

        .user-info .user-name {
            font-size: 14px;
            color: white;
            font-weight: 500;
        }

        .user-info .user-role {
            font-size: 12px;
            color: var(--sidebar-text);
        }

        .sidebar-nav {
            flex: 1;
            padding: 12px 0;
            overflow-y: auto;
        }

        .nav-section-title {
            padding: 8px 20px 4px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: rgba(255,255,255,0.3);
            font-weight: 600;
        }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 10px 20px;
            cursor: pointer;
            transition: all 0.15s;
            font-size: 14px;
            color: var(--sidebar-text);
            border-left: 3px solid transparent;
            gap: 12px;
        }

        .nav-item:hover {
            background: rgba(255,255,255,0.05);
            color: white;
        }

        .nav-item.active {
            background: rgba(74, 124, 89, 0.2);
            color: white;
            border-left-color: var(--primary);
        }

        .nav-item.nav-subitem {
            padding-left: 48px;
            font-size: 13px;
            color: rgba(184, 201, 185, 0.75);
            border-left: 3px solid transparent;
        }

        .nav-item.nav-subitem:hover {
            background: rgba(255,255,255,0.05);
            color: white;
        }

        .nav-item.nav-subitem.active {
            background: rgba(74, 124, 89, 0.15);
            color: white;
            border-left-color: var(--accent);
        }

        .nav-item .nav-icon {
            width: 20px;
            text-align: center;
            font-size: 15px;
        }

        .nav-item .nav-badge {
            margin-left: auto;
            background: var(--danger);
            color: white;
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 10px;
            font-weight: 600;
        }

        .sidebar-footer {
            padding: 16px 20px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .sidebar-footer .nav-item {
            padding: 8px 0;
            border: none;
        }

        /* ========== 主内容区 ========== */
        .main-content {
            margin-left: 240px;
            flex: 1;
            min-height: 100vh;
        }

        .topbar {
            background: white;
            border-bottom: 1px solid var(--border);
            padding: 16px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .topbar-title h1 {
            font-size: 18px;
            font-weight: 600;
        }

        .topbar-title .breadcrumb {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-date {
            font-size: 13px;
            color: var(--text-secondary);
            padding: 6px 12px;
            background: var(--bg);
            border-radius: 6px;
        }

        .page-content {
            padding: 24px 32px;
        }

        /* ========== 页面 ========== */
        .page { display: none; }
        .page.active { display: block; }

        /* ========== 总览页 - 三栏布局 ========== */
        .overview-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 340px;
            gap: 20px;
        }

        .overview-grid .col-span-2 {
            grid-column: span 2;
        }

        /* KPI 卡片行 */
        .kpi-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 20px;
            grid-column: 1 / -1;
        }

        .kpi-card {
            background: white;
            border-radius: var(--radius);
            padding: 20px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
        }

        .kpi-card .kpi-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .kpi-card .kpi-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .kpi-card .kpi-icon.green { background: var(--primary-light); }
        .kpi-card .kpi-icon.orange { background: var(--accent-light); }
        .kpi-card .kpi-icon.blue { background: var(--info-light); }
        .kpi-card .kpi-icon.purple { background: var(--purple-light); }

        .kpi-card .kpi-trend {
            font-size: 12px;
            padding: 2px 8px;
            border-radius: 12px;
            font-weight: 500;
        }

        .kpi-card .kpi-trend.up { background: var(--primary-light); color: var(--primary); }
        .kpi-card .kpi-trend.down { background: var(--danger-light); color: var(--danger); }

        .kpi-card .kpi-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--text);
            line-height: 1.2;
        }

        .kpi-card .kpi-label {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* 卡片 */
        .card {
            background: white;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .card-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .card-header h3 {
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-header .card-action {
            font-size: 12px;
            color: var(--primary);
            cursor: pointer;
            text-decoration: none;
        }

        .card-header .card-action:hover {
            text-decoration: underline;
        }

        .card-body {
            padding: 16px 20px;
        }

        .card-body.no-padding {
            padding: 0;
        }

        /* 目标进度 */
        .goal-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .goal-item {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .goal-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .goal-icon.chinese { background: #fef3e8; }
        .goal-icon.math { background: #e8f0fe; }
        .goal-icon.english { background: #fce8e8; }
        .goal-icon.od { background: #e8f5e8; }

        .goal-info {
            flex: 1;
            min-width: 0;
        }

        .goal-info .goal-name {
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 6px;
        }

        .goal-bar {
            height: 6px;
            background: #f0f0f0;
            border-radius: 3px;
            overflow: hidden;
        }

        .goal-bar .fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.6s ease;
        }

        .goal-bar .fill.green { background: var(--primary); }
        .goal-bar .fill.blue { background: var(--info); }
        .goal-bar .fill.orange { background: var(--accent); }
        .goal-bar .fill.red { background: var(--danger); }

        .goal-percent {
            font-size: 14px;
            font-weight: 600;
            width: 42px;
            text-align: right;
            flex-shrink: 0;
        }

        /* 打卡清单 */
        .checkin-list {
            display: flex;
            flex-direction: column;
        }

        .checkin-item {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            gap: 12px;
            cursor: pointer;
            transition: background 0.15s;
            border-bottom: 1px solid #f5f5f5;
        }

        .checkin-item:last-child { border-bottom: none; }

        .checkin-item:hover {
            background: #fafafa;
        }

        .checkin-item.completed {
            background: var(--primary-light);
        }

        .check-box {
            width: 22px;
            height: 22px;
            border: 2px solid #d0d0d0;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .checkin-item.completed .check-box {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
            font-size: 12px;
        }

        .checkin-item .task-icon {
            font-size: 16px;
        }

        .checkin-item .task-name {
            flex: 1;
            font-size: 14px;
        }

        .checkin-item.completed .task-name {
            color: var(--text-muted);
            text-decoration: line-through;
        }

        .checkin-item .task-time {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* 错题分布 */
        .mistake-chart {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .mistake-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .mistake-row .subject {
            width: 40px;
            font-size: 13px;
            color: var(--text-secondary);
        }

        .mistake-row .bar-wrap {
            flex: 1;
            height: 20px;
            background: #f5f5f5;
            border-radius: 4px;
            overflow: hidden;
        }

        .mistake-row .bar-fill {
            height: 100%;
            border-radius: 4px;
            display: flex;
            align-items: center;
            padding-left: 8px;
            font-size: 11px;
            color: white;
            font-weight: 500;
        }

        .mistake-row .count {
            width: 30px;
            font-size: 13px;
            font-weight: 600;
            text-align: right;
        }

        /* 留言区 */
        .message-list {
            max-height: 200px;
            overflow-y: auto;
        }

        .message-item {
            padding: 12px 0;
            border-bottom: 1px solid #f5f5f5;
        }

        .message-item:last-child { border-bottom: none; }

        .message-item .msg-content {
            font-size: 14px;
            color: var(--text);
            line-height: 1.5;
        }

        .message-item .msg-time {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .message-input-wrap {
            display: flex;
            gap: 8px;
            padding-top: 12px;
            border-top: 1px solid var(--border);
            margin-top: 8px;
        }

        .message-input-wrap input {
            flex: 1;
            padding: 10px 14px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 13px;
            background: #fafafa;
        }

        .message-input-wrap input:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
        }

        .message-input-wrap button {
            padding: 10px 16px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
        }

        /* 打卡热力图（真实月历模式） */
        .calendar-heatmap {
            font-size: 12px;
        }

        .cal-header {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            text-align: center;
            color: var(--text-muted);
            font-size: 12px;
            margin-bottom: 6px;
        }

        .cal-header .weekend {
            color: var(--accent);
            font-weight: 600;
        }

        .cal-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
        }

        .cal-cell {
            aspect-ratio: 1;
            border-radius: 6px;
            background: #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #555;
            position: relative;
            cursor: default;
            transition: transform 0.1s;
        }

        .cal-cell:hover {
            transform: scale(1.08);
        }

        .cal-cell.empty {
            background: transparent;
        }

        .cal-cell.today {
            box-shadow: inset 0 0 0 2px var(--primary);
            font-weight: 700;
            color: var(--primary);
        }

        .cal-cell.weekend {
            background: #f7f0ea;
        }

        .cal-cell.level-1 { background: #c8e6c9; }
        .cal-cell.level-2 { background: #81c784; }
        .cal-cell.level-3 { background: #4caf50; color: #fff; font-weight: 600; }
        .cal-cell.level-4 { background: #2e7d32; color: #fff; font-weight: 600; }

        .cal-legend {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 4px;
            margin-top: 10px;
            font-size: 11px;
            color: var(--text-muted);
        }

        .cal-legend .legend-dot {
            width: 12px;
            height: 12px;
            border-radius: 3px;
            display: inline-block;
        }

        .cal-legend .legend-dot.level-1 { background: #c8e6c9; }
        .cal-legend .legend-dot.level-2 { background: #81c784; }
        .cal-legend .legend-dot.level-3 { background: #4caf50; }
        .cal-legend .legend-dot.level-4 { background: #2e7d32; }

        /* 空状态 */
        .empty-state {
            text-align: center;
            padding: 32px 16px;
            color: var(--text-muted);
        }

        .empty-state .empty-icon {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .empty-state p {
            font-size: 13px;
        }

        /* 小按钮 */
        .btn-small {
            padding: 8px 16px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-back {
            padding: 6px 14px;
            background: #f0f0f0;
            color: var(--text-secondary);
            border: none;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .btn-back:hover {
            background: #e0e0e0;
            color: var(--text);
        }

        .btn-small:hover {
            background: #3d6a4a;
        }

        .btn-small.secondary {
            background: #f0f0f0;
            color: var(--text);
        }

        .btn-small.secondary:hover {
            background: #e0e0e0;
        }

        .btn-small.danger {
            background: var(--danger-light);
            color: var(--danger);
        }

        .btn-small.danger:hover {
            background: #f8d7d0;
        }

        /* 打卡清单（家长端） */
        .checkin-group {
            margin-bottom: 16px;
        }

        .checkin-group-header {
            display: flex;
            align-items: center;
            padding: 10px 16px;
            background: var(--primary-light);
            border-radius: 8px 8px 0 0;
            gap: 8px;
            font-weight: 600;
            font-size: 14px;
        }

        .checkin-group-header .group-count {
            margin-left: auto;
            font-size: 12px;
            font-weight: 500;
            color: var(--primary);
        }

        .checkin-group-body {
            border: 1px solid #f0f0f0;
            border-top: none;
            border-radius: 0 0 8px 8px;
            padding: 8px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .checkin-row {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            border-radius: 6px;
            gap: 10px;
            cursor: pointer;
            transition: background 0.15s;
        }

        .checkin-row:hover {
            background: #fafafa;
        }

        .checkin-row.completed {
            background: var(--primary-light);
        }

        .checkin-row .check-box {
            width: 20px;
            height: 20px;
            border: 2px solid #d0d0d0;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            color: white;
            flex-shrink: 0;
        }

        .checkin-row.completed .check-box {
            background: var(--primary);
            border-color: var(--primary);
        }

        .checkin-row .task-icon {
            font-size: 15px;
        }

        .checkin-row .task-name {
            flex: 1;
            font-size: 14px;
        }

        .checkin-row.completed .task-name {
            color: var(--text-muted);
            text-decoration: line-through;
        }

        .checkin-row .task-time {
            font-size: 11px;
            color: var(--text-muted);
        }

        /* 拖拽排序 */
        .drag-handle {
            cursor: grab;
            padding: 4px 8px;
            color: var(--text-muted);
            font-size: 16px;
            user-select: none;
            opacity: 0.5;
            transition: opacity 0.2s;
        }

        .drag-handle:hover {
            opacity: 1;
            color: var(--primary);
        }

        .drag-handle:active {
            cursor: grabbing;
        }

        .sortable-ghost {
            opacity: 0.4;
            background: var(--primary-light);
        }

        .sortable-chosen {
            background: var(--accent-light);
        }

        .btn-save-sort {
            margin-left: 10px;
            padding: 6px 14px;
            font-size: 13px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            display: none;
        }

        .btn-save-sort.show {
            display: inline-block;
        }

        .btn-save-sort:hover {
            background: #3d6b4a;
        }

        /* 作业提交 */
        .btn-submit-photo {
            margin-left: 8px;
            padding: 4px 10px;
            font-size: 12px;
            border: 1.5px solid var(--primary);
            background: #fff;
            color: var(--primary);
            border-radius: 14px;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.15s;
        }

        .btn-submit-photo:hover {
            background: var(--primary);
            color: #fff;
        }

        .sub-badge {
            margin-left: 8px;
            padding: 2px 8px;
            font-size: 11px;
            background: #eef2ff;
            color: #4f46e5;
            border-radius: 10px;
            white-space: nowrap;
        }

        .sub-badge.graded {
            background: #e6f9e9;
            color: #2e7d32;
            font-weight: 600;
        }

        .submit-preview img {
            max-width: 100%;
            border-radius: 8px;
            margin-top: 8px;
        }

        .upload-area {
            border: 2px dashed var(--border);
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
        }

        .upload-area:hover {
            border-color: var(--primary);
            background: var(--primary-light);
        }

        /* 任务配置列表 */
        .task-config-item {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            border-bottom: 1px solid #f5f5f5;
            gap: 10px;
            transition: background 0.15s;
        }

        .task-config-item:last-child {
            border-bottom: none;
        }

        .task-config-item:hover {
            background: #fafafa;
        }

        .task-config-item .task-icon {
            font-size: 18px;
        }

        .task-config-item .task-info {
            flex: 1;
            min-width: 0;
        }

        .task-config-item .task-name {
            font-size: 14px;
            font-weight: 500;
        }

        .task-config-item .task-meta {
            font-size: 12px;
            color: var(--text-muted);
        }

        .task-config-item .task-actions {
            display: flex;
            gap: 6px;
        }

        .task-config-item.child {
            padding-left: 48px;
            background: #fafafa;
        }

        .task-config-empty {
            padding: 8px 20px 12px 48px;
            font-size: 12px;
            color: var(--text-muted);
        }

        .task-config-item.child:hover {
            background: #f5f5f5;
        }

        /* 质量评分星星 */
        .quality-stars {
            display: inline-flex;
            gap: 4px;
            margin-left: 8px;
            vertical-align: middle;
        }

        .q-star {
            cursor: pointer;
            font-size: 12px;
            padding: 2px 6px;
            border-radius: 4px;
            background: #f0f0f0;
            color: #999;
            transition: all 0.15s;
            user-select: none;
        }

        .q-star:hover {
            background: #e8e8e8;
        }

        .q-star.active {
            background: #fff3cd;
            color: #d4a574;
        }

        .q-star[data-quality="0"].active {
            background: #fceae8;
            color: #c0392b;
        }

        /* 模态框 */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.4);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-box {
            background: white;
            border-radius: 16px;
            padding: 24px;
            width: 480px;
            max-width: 90vw;
            max-height: 85vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        }

        .modal-box h3 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .modal-form .form-group {
            margin-bottom: 14px;
        }

        .modal-form label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .modal-form input,
        .modal-form select,
        .modal-form textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
            background: #fafafa;
        }

        .modal-form input:focus,
        .modal-form select:focus,
        .modal-form textarea:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
        }

        .modal-form textarea {
            height: 60px;
            resize: none;
            font-family: inherit;
        }

        .modal-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 20px;
        }

        /* ========== 响应式 ========== */
        @media (max-width: 1200px) {
            .overview-grid {
                grid-template-columns: 1fr 1fr;
            }
            .overview-grid .col-span-2 {
                grid-column: span 2;
            }
        }

        @media (max-width: 768px) {
            .sidebar { display: none; }
            .sidebar.mobile-open { display: block; }
            .main-content { margin-left: 0; }
            .kpi-row { grid-template-columns: repeat(2, 1fr); }
            .overview-grid { grid-template-columns: 1fr; }
            .overview-grid .col-span-2 { grid-column: span 1; }
            .page-content { padding: 16px; }
            
            /* 手机端汉堡菜单按钮 */
            .mobile-menu-btn {
                display: block;
                background: none;
                border: none;
                font-size: 24px;
                cursor: pointer;
                padding: 8px;
                margin-right: 12px;
                color: var(--text);
            }
            
            /* 手机端打卡清单优化 */
            .checkin-row {
                flex-wrap: wrap;
                gap: 8px;
            }
            .checkin-row .task-name {
                flex: 1 1 auto;
                min-width: 0;
            }
            .quality-stars {
                flex: 0 0 auto;
                margin-left: 0;
                width: 100%;
                margin-top: 4px;
            }
            .btn-submit-photo {
                flex: 0 0 auto;
            }
        }
        
        /* 汉堡按钮默认隐藏（桌面端） */
        .mobile-menu-btn {
            display: none;
        }

        /* ========== 错题本样式 ========== */
        .mistake-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 12px;
            margin-bottom: 20px;
        }
        .mistake-stat-card {
            background: var(--bg);
            border-radius: var(--radius-sm);
            padding: 12px;
            text-align: center;
        }
        .mistake-stat-value {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary);
        }
        .mistake-stat-label {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 4px;
        }
        .mistake-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .mistake-item {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px;
            transition: all 0.2s;
        }
        .mistake-item:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow);
        }
        .mistake-item.corrected {
            opacity: 0.6;
            border-left: 3px solid var(--primary);
        }
        .mistake-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .mistake-subject-tag {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
            background: var(--primary-light);
            color: var(--primary);
        }
        .mistake-status-tag {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
        }
        .mistake-status-tag.uncorrected {
            background: var(--danger-light);
            color: var(--danger);
        }
        .mistake-status-tag.corrected {
            background: var(--primary-light);
            color: var(--primary);
        }
        .mistake-topic {
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 4px;
        }
        .mistake-description {
            font-size: 13px;
            color: var(--text);
            margin-bottom: 8px;
            padding: 8px;
            background: var(--bg);
            border-radius: 6px;
        }
        .mistake-reason {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }
        .mistake-actions {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }
        .mistake-btn {
            padding: 6px 12px;
            border: none;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .mistake-btn.correct {
            background: var(--primary);
            color: white;
        }
        .mistake-btn.correct:hover {
            background: #3d6a4a;
        }
        .mistake-btn.uncorrect {
            background: var(--bg);
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }
        .mistake-btn.uncorrect:hover {
            background: var(--border);
        }

        /* ========== 试卷分析页样式 ========== */
        .exam-filters {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }
        .exam-filters select {
            padding: 8px 12px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
            background: white;
            cursor: pointer;
        }
        .exam-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .exam-item {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px 20px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .exam-item:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow);
        }
        .exam-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .exam-item-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text);
        }
        .exam-item-meta {
            display: flex;
            gap: 12px;
            font-size: 13px;
            color: var(--text-secondary);
        }
        .exam-item-meta .tag {
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
        }
        .tag-subject { background: var(--primary-light); color: var(--primary); }
        .tag-type { background: var(--accent-light); color: var(--accent); }
        .exam-accuracy {
            font-size: 18px;
            font-weight: 700;
        }
        .accuracy-high { color: var(--primary); }
        .accuracy-mid { color: var(--accent); }
        .accuracy-low { color: var(--danger); }

        /* 试卷详情弹窗 */
        .exam-modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }
        .exam-modal-overlay.active { display: flex; }
        .exam-modal {
            background: white;
            border-radius: 16px;
            width: 90%;
            max-width: 700px;
            max-height: 85vh;
            overflow-y: auto;
            padding: 24px;
        }
        .exam-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }
        .exam-modal-close {
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--text-muted);
        }
        .exam-question-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .exam-question-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 10px 12px;
            border-radius: 8px;
            background: #fafafa;
            font-size: 13px;
        }
        .exam-question-item.correct { border-left: 3px solid var(--primary); }
        .exam-question-item.wrong { border-left: 3px solid var(--danger); }
        .exam-q-num {
            font-weight: 600;
            min-width: 24px;
            color: var(--text-secondary);
        }
        .exam-q-content { flex: 1; }
        .exam-q-answer { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
        .exam-q-error { font-size: 12px; color: var(--danger); margin-top: 2px; }
        .exam-summary-box {
            background: var(--info-light);
            border-radius: 8px;
            padding: 12px 16px;
            margin-top: 16px;
            font-size: 13px;
            color: var(--info);
        }

        /* 上传试卷弹窗 */
        .upload-exam-modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }
        .upload-exam-modal-overlay.active { display: flex; }
        .upload-exam-modal {
            background: white;
            border-radius: 16px;
            width: 90%;
            max-width: 480px;
            padding: 24px;
        }
        .upload-exam-modal h3 {
            margin-bottom: 16px;
            font-size: 18px;
        }
        .upload-exam-form .form-group {
            margin-bottom: 14px;
        }
        .upload-exam-form label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 4px;
        }
        .upload-exam-form select,
        .upload-exam-form input {
            width: 100%;
            padding: 10px 12px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
        }
        .upload-exam-form input[type="file"] {
            padding: 8px;
        }
        .btn-upload-exam {
            width: 100%;
            padding: 12px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
        }
        .btn-upload-exam:hover { background: #3d6a4a; }
        .btn-upload-exam:disabled { opacity: 0.6; cursor: not-allowed; }

        /* 趋势图 */
        .trend-chart-container {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .trend-subject-row {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .trend-subject-label {
            font-weight: 600;
            min-width: 40px;
        }
        .trend-bars {
            flex: 1;
            display: flex;
            gap: 4px;
            align-items: flex-end;
            height: 60px;
        }
        .trend-bar {
            flex: 1;
            min-width: 20px;
            max-width: 40px;
            border-radius: 4px 4px 0 0;
            transition: all 0.3s;
            position: relative;
        }
        .trend-bar:hover { opacity: 0.8; }
        .trend-bar-label {
            position: absolute;
            bottom: -18px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 10px;
            color: var(--text-muted);
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <!-- 登录页 -->
    <div class="login-page" id="loginPage">
        <div class="login-card">
            <div class="logo">
                <div class="logo-icon">🎒</div>
                <h1>学习管理台</h1>
                <p class="subtitle">家长端登录</p>
            </div>
            <div class="form-group">
                <label>用户名</label>
                <input type="text" class="form-input" id="loginUsername" placeholder="请输入用户名">
            </div>
            <div class="form-group">
                <label>密码</label>
                <input type="password" class="form-input" id="loginPassword" placeholder="请输入密码">
            </div>
            <button class="btn-primary" onclick="doLogin()">登 录</button>
            <p class="login-error" id="loginError">用户名或密码错误</p>
        </div>
    </div>

    <!-- 主应用 -->
    <div class="app-layout" id="appLayout">
        <!-- 侧边栏 -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <h2><span class="brand-icon">🎒</span> 学习管理台</h2>
            </div>
            <div class="sidebar-user">
                <div class="user-avatar" id="userAvatar">爸</div>
                <div class="user-info">
                    <div class="user-name" id="userName">爸爸</div>
                    <div class="user-role">家长</div>
                </div>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-section-title">主要功能</div>
                <div class="nav-item active" data-page="overview" onclick="switchPage('overview')">
                    <span class="nav-icon">📊</span> 概览
                </div>
                <div class="nav-item" data-page="goals" onclick="switchPage('goals')">
                    <span class="nav-icon">🎯</span> 学期目标
                </div>
                <div class="nav-item" data-page="checkins" onclick="switchPage('checkins')">
                    <span class="nav-icon">✅</span> 每日打卡
                </div>
                <div class="nav-item nav-subitem" data-page="settings" onclick="switchPage('settings')">
                    <span class="nav-icon">⚙️</span> 任务配置
                </div>
                <div class="nav-item" data-page="mistakes" onclick="switchPage('mistakes')">
                    <span class="nav-icon">📝</span> 错题本
                </div>
                <div class="nav-item" data-page="exams" onclick="switchPage('exams')">
                    <span class="nav-icon">📄</span> 试卷分析
                </div>
                <div class="nav-item" data-page="points" onclick="switchPage('points')">
                    <span class="nav-icon">🏆</span> 积分管理
                </div>
                <div class="nav-item" data-page="rewards" onclick="switchPage('rewards')">
                    <span class="nav-icon">🎁</span> 奖励配置
                </div>
                <div class="nav-section-title">更多</div>
                <div class="nav-item" data-page="review" onclick="switchPage('review')">
                    <span class="nav-icon">📈</span> 周报复盘
                </div>
                <div class="nav-item" data-page="focus" onclick="switchPage('focus')">
                    <span class="nav-icon">⏱</span> 专注计时
                </div>
                <div class="nav-item" data-page="books" onclick="switchPage('books')">
                    <span class="nav-icon">📚</span> 阅读书单
                </div>
                <div class="nav-item" data-page="calendar" onclick="switchPage('calendar')">
                    <span class="nav-icon">📅</span> 学习日历
                </div>
                <div class="nav-item" data-page="messages" onclick="switchPage('messages')">
                    <span class="nav-icon">💬</span> 家长留言
                </div>
            </nav>
            <div class="sidebar-footer">
                <div class="nav-item" onclick="doLogout()">
                    <span class="nav-icon">🚪</span> 退出登录
                </div>
            </div>
        </aside>

        <!-- 主内容 -->
        <main class="main-content">
            <div class="topbar">
                <button class="mobile-menu-btn" id="mobileMenuBtn" onclick="toggleMobileMenu()">☰</button>
                <div class="topbar-title">
                    <h1 id="pageTitle">概览</h1>
                    <div class="breadcrumb" id="pageBreadcrumb">首页 / 概览</div>
                </div>
                <div class="topbar-actions">
                    <div class="topbar-date" id="topbarDate"></div>
                </div>
            </div>

            <div class="page-content">
                <!-- 概览页 -->
                <div class="page active" id="page-overview">
                    <!-- KPI 行 -->
                    <div class="kpi-row">
                        <div class="kpi-card">
                            <div class="kpi-header">
                                <div class="kpi-icon green">📊</div>
                                <span class="kpi-trend up" id="kpiTrend">--</span>
                            </div>
                            <div class="kpi-value" id="kpiRate">--%</div>
                            <div class="kpi-label">今日完成率</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-header">
                                <div class="kpi-icon orange">🔥</div>
                            </div>
                            <div class="kpi-value" id="kpiStreak">0天</div>
                            <div class="kpi-label">连续打卡</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-header">
                                <div class="kpi-icon blue">📝</div>
                            </div>
                            <div class="kpi-value" id="kpiMistakes">0</div>
                            <div class="kpi-label">本周错题</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-header">
                                <div class="kpi-icon purple">💬</div>
                            </div>
                            <div class="kpi-value" id="kpiMessages">0</div>
                            <div class="kpi-label">未读留言</div>
                        </div>
                    </div>

                    <!-- 三栏内容 -->
                    <div class="overview-grid">
                        <!-- 左栏：目标进度 -->
                        <div class="card">
                            <div class="card-header">
                                <h3>🎯 学期目标进度</h3>
                                <a class="card-action" onclick="switchPage('goals')">查看详情 →</a>
                            </div>
                            <div class="card-body">
                                <div class="goal-list" id="goalProgress">
                                    <!-- 动态填充 -->
                                </div>
                            </div>
                        </div>

                        <!-- 中栏：打卡清单 + 热力图 -->
                        <div style="display:flex;flex-direction:column;gap:20px;">
                            <div class="card">
                                <div class="card-header">
                                    <h3>📅 今日打卡</h3>
                                    <a class="card-action" onclick="switchPage('checkins')">管理 →</a>
                                </div>
                                <div class="card-body no-padding">
                                    <div class="checkin-list" id="todayCheckins">
                                        <!-- 动态填充 -->
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header">
                                    <h3>📆 本月打卡热力图</h3>
                                </div>
                                <div class="card-body">
                                    <div class="calendar-heatmap" id="heatmap">
                                        <div class="empty-state"><div class="empty-icon">📅</div><p>加载中...</p></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 右栏：错题 + 留言 -->
                        <div style="display:flex;flex-direction:column;gap:20px;">
                            <div class="card">
                                <div class="card-header">
                                    <h3>📝 错题分布</h3>
                                    <a class="card-action" onclick="switchPage('mistakes')">全部 →</a>
                                </div>
                                <div class="card-body">
                                    <div class="mistake-chart" id="mistakeChart">
                                        <!-- 动态填充 -->
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header">
                                    <h3>💬 家长留言</h3>
                                </div>
                                <div class="card-body">
                                    <div class="message-list" id="messageList">
                                        <!-- 动态填充 -->
                                    </div>
                                    <div class="message-input-wrap">
                                        <input type="text" id="messageInput" placeholder="写句鼓励的话...">
                                        <button onclick="sendMessage()">发送</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 其他页面占位 -->
                <div class="page" id="page-goals"><div class="card"><div class="card-body"><div class="empty-state"><div class="empty-icon">🎯</div><p>学期目标管理 — 开发中</p></div></div></div></div>
                <!-- 每日打卡页 -->
                <div class="page" id="page-checkins">
                    <div class="card">
                        <div class="card-header">
                            <button class="btn-back" onclick="switchPage('overview')">← 返回</button>
                            <h3>📅 每日打卡清单</h3>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <input type="date" id="checkinDate" value="" style="padding:6px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;" onchange="loadCheckinDate()">
                                <span id="checkinRate" style="font-size:13px;font-weight:600;color:var(--primary);"></span>
                            </div>
                        </div>
                        <div class="card-body" id="checkinListContainer">
                            <div class="empty-state"><div class="empty-icon">📋</div><p>加载中...</p></div>
                        </div>
                    </div>
                </div>

                <!-- 任务配置页 -->
                <div class="page" id="page-settings">
                    <div class="card">
                        <div class="card-header">
                            <button class="btn-back" onclick="switchPage('checkins')">← 返回</button>
                            <h3>⚙️ 任务配置</h3>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <input type="date" id="taskConfigDate" value="" style="padding:6px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;" onchange="loadTaskConfig()">
                                <button class="btn-small" onclick="showAddTaskModal()">+ 新增任务</button>
                            </div>
                        </div>
                        <div class="card-body no-padding">
                            <div id="taskConfigList">
                                <div class="empty-state"><div class="empty-icon">⚙️</div><p>加载中...</p></div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- 错题本页 -->
                <div class="page" id="page-mistakes">
                    <div class="card">
                        <div class="card-header">
                            <h3>📝 错题本</h3>
                            <button class="btn btn-primary btn-sm" onclick="showAddMistakeModal()">添加错题</button>
                        </div>
                        <div class="card-body">
                            <!-- 统计卡片 -->
                            <div class="mistake-stats" id="mistakeStats"></div>
                            
                            <!-- 筛选区 -->
                            <div class="exam-filters">
                                <select id="mistakeSubjectFilter" onchange="loadMistakeList()">
                                    <option value="">全部科目</option>
                                    <option value="语文">语文</option>
                                    <option value="数学">数学</option>
                                    <option value="英语">英语</option>
                                    <option value="其他">其他</option>
                                </select>
                                <select id="mistakeStatusFilter" onchange="loadMistakeList()">
                                    <option value="">全部状态</option>
                                    <option value="0">未订正</option>
                                    <option value="1">已订正</option>
                                </select>
                            </div>
                            
                            <!-- 错题列表 -->
                            <div id="mistakeListContainer">
                                <div class="empty-state">
                                    <div class="empty-icon">📝</div>
                                    <p>暂无错题记录</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 试卷分析页 -->
                <div class="page" id="page-exams">
                    <div class="card">
                        <div class="card-header">
                            <h3>📄 试卷分析</h3>
                            <button class="btn btn-primary btn-sm" onclick="showUploadExamModal()">上传试卷</button>
                        </div>
                        <div class="card-body">
                            <!-- 筛选区 -->
                            <div class="exam-filters">
                                <select id="examSubjectFilter" onchange="loadExamList()">
                                    <option value="">全部科目</option>
                                    <option value="语文">语文</option>
                                    <option value="数学">数学</option>
                                    <option value="英语">英语</option>
                                </select>
                                <select id="examTypeFilter" onchange="loadExamList()">
                                    <option value="">全部类型</option>
                                    <option value="考试">考试</option>
                                    <option value="练习册">练习册</option>
                                </select>
                            </div>
                            
                            <!-- 试卷列表 -->
                            <div id="examListContainer">
                                <div class="empty-state">
                                    <div class="empty-icon">📄</div>
                                    <p>暂无试卷记录</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 趋势分析卡片 -->
                    <div class="card" style="margin-top: 20px;">
                        <div class="card-header">
                            <h3>📈 趋势分析</h3>
                        </div>
                        <div class="card-body">
                            <div id="examTrendContainer">
                                <div class="empty-state">
                                    <div class="empty-icon">📊</div>
                                    <p>上传试卷后查看趋势</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 积分管理页 -->
                <div class="page" id="page-points">
                    <div class="card">
                        <div class="card-header">
                            <h3>🏆 积分管理</h3>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <span id="pointsBalance" style="font-size:18px;font-weight:700;color:var(--accent);"></span>
                                <button class="btn-small" onclick="checkWeeklyBonus()" style="background:var(--purple);">📋 周全勤检查</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div id="weeklyBonusResult" style="display:none;margin-bottom:16px;"></div>
                            <h4 style="margin-bottom:12px;font-size:14px;color:var(--text-secondary);">积分流水</h4>
                            <div id="pointsLedger">
                                <div class="empty-state"><div class="empty-icon">📋</div><p>加载中...</p></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 奖励配置页 -->
                <div class="page" id="page-rewards">
                    <div class="card">
                        <div class="card-header">
                            <button class="btn-back" onclick="switchPage('points')">← 返回</button>
                            <h3>🎁 奖励配置</h3>
                            <button class="btn-small" onclick="showAddRewardModal()">+ 新增奖励</button>
                        </div>
                        <div class="card-body no-padding">
                            <div id="rewardsList">
                                <div class="empty-state"><div class="empty-icon">🎁</div><p>加载中...</p></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="page" id="page-review"><div class="card"><div class="card-body"><div class="empty-state"><div class="empty-icon">📈</div><p>周报复盘 — 开发中</p></div></div></div></div>
                <div class="page" id="page-focus"><div class="card"><div class="card-body"><div class="empty-state"><div class="empty-icon">⏱</div><p>专注计时 — 开发中</p></div></div></div></div>
                <div class="page" id="page-books"><div class="card"><div class="card-body"><div class="empty-state"><div class="empty-icon">📚</div><p>阅读书单 — 开发中</p></div></div></div></div>
                <div class="page" id="page-calendar"><div class="card"><div class="card-body"><div class="empty-state"><div class="empty-icon">📅</div><p>学习日历 — 开发中</p></div></div></div></div>
                <div class="page" id="page-messages"><div class="card"><div class="card-body"><div class="empty-state"><div class="empty-icon">💬</div><p>家长留言 — 开发中</p></div></div></div></div>
            </div>
        </main>
    </div>

    <!-- 任务编辑模态框 -->
    <div class="modal-overlay" id="taskModal">
        <div class="modal-box">
            <h3 id="taskModalTitle">新增任务</h3>
            <div class="modal-form">
                <div class="form-group">
                    <label>任务名称</label>
                    <input type="text" id="taskName" placeholder="例如：口语表述 Workbook P22">
                </div>
                <div class="form-group">
                    <label>所属大类</label>
                    <select id="taskParent">
                        <option value="0">顶级任务（不分组）</option>
                        <!-- 动态填充大类 -->
                    </select>
                </div>
                <div class="form-group">
                    <label>科目</label>
                    <select id="taskSubject">
                        <option value="语文">📖 语文</option>
                        <option value="数学">🔢 数学</option>
                        <option value="英语">🔤 英语</option>
                        <option value="OD">📗 OD</option>
                        <option value="其他">📝 其他</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>图标</label>
                    <input type="text" id="taskIcon" placeholder="例如：📖 🎤 ✍️ 📚">
                </div>
                <div class="form-group">
                    <label>任务类型</label>
                    <select id="taskType">
                        <option value="general">📌 通用</option>
                        <option value="reading">📖 朗读</option>
                        <option value="writing">✍️ 书写</option>
                        <option value="speaking">🗣️ 口语</option>
                        <option value="workbook">📚 练习册</option>
                        <option value="review">🔁 复习</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>描述（可选）</label>
                    <textarea id="taskDescription" placeholder="任务说明..."></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-small secondary" onclick="closeTaskModal()">取消</button>
                <button class="btn-small" id="taskModalSave" onclick="saveTask()">保存</button>
            </div>
        </div>
    </div>

    <!-- 作业提交模态框 -->
    <div class="modal-overlay" id="submitModal">
        <div class="modal-box">
            <h3 id="submitModalTitle">📷 提交作业</h3>
            <div class="modal-form">
                <div class="upload-area" onclick="document.getElementById('submitFileInput').click()">
                    <div style="font-size:28px;">📷</div>
                    <div style="font-size:13px;color:var(--text-muted);margin-top:4px;">点击选择照片 / 拍照上传</div>
                    <input type="file" id="submitFileInput" accept="image/*" capture="environment" style="display:none">
                </div>
                <div class="submit-preview" id="submitPreview"></div>
                <div id="submitResult" style="display:none;"></div>
            </div>
            <div class="modal-actions">
                <button class="btn-small secondary" onclick="closeSubmitModal()">关闭</button>
                <button class="btn-small" id="submitBtn" onclick="uploadSubmission()">提交作业</button>
            </div>
        </div>
    </div>

    <!-- 奖励编辑模态框 -->
    <div class="modal-overlay" id="rewardModal">
        <div class="modal-box">
            <h3 id="rewardModalTitle">新增奖励</h3>
            <div class="modal-form">
                <div class="form-group">
                    <label>奖励名称</label>
                    <input type="text" id="rewardName" placeholder="例如：多看一集动画">
                </div>
                <div class="form-group">
                    <label>所需积分</label>
                    <input type="number" id="rewardCost" placeholder="30" min="1">
                </div>
                <div class="form-group">
                    <label>图标（emoji）</label>
                    <input type="text" id="rewardIcon" placeholder="🎁" maxlength="4">
                </div>
                <div class="form-group">
                    <label>描述（可选）</label>
                    <textarea id="rewardDesc" placeholder="奖励说明..."></textarea>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-small secondary" onclick="closeRewardModal()">取消</button>
                <button class="btn-small" id="rewardModalSave" onclick="saveReward()">保存</button>
            </div>
        </div>
    </div>

    <script>
        const API_BASE = '/xuexi/api';
        // 获取本地日期（解决 toISOString() 时区问题）
        function getLocalDate(d = new Date()) {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }
        let token = localStorage.getItem('xuexi_token');
        let currentUser = JSON.parse(localStorage.getItem('xuexi_user') || 'null');
        let studentId = null;

        if (token && currentUser && currentUser.role === 'parent') {
            showApp();
        }

        async function doLogin() {
            const username = document.getElementById('loginUsername').value;
            const password = document.getElementById('loginPassword').value;
            try {
                const res = await fetch(`${API_BASE}/auth/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });
                if (!res.ok) { document.getElementById('loginError').style.display = 'block'; return; }
                const data = await res.json();
                if (data.user.role !== 'parent') {
                    document.getElementById('loginError').textContent = '请使用家长账号登录';
                    document.getElementById('loginError').style.display = 'block';
                    return;
                }
                token = data.token;
                currentUser = data.user;
                localStorage.setItem('xuexi_token', token);
                localStorage.setItem('xuexi_user', JSON.stringify(currentUser));
                showApp();
            } catch (e) {
                document.getElementById('loginError').style.display = 'block';
            }
        }

        function showApp() {
            document.getElementById('loginPage').style.display = 'none';
            document.getElementById('appLayout').classList.add('active');
            document.getElementById('userName').textContent = currentUser.display_name;
            document.getElementById('userAvatar').textContent = currentUser.display_name.charAt(0);
            
            const now = new Date();
            document.getElementById('topbarDate').textContent = now.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
            
            studentId = 2; // 小石榴
            loadOverview();
        }

        function doLogout() {
            localStorage.removeItem('xuexi_token');
            localStorage.removeItem('xuexi_user');
            location.reload();
        }

        const pageTitles = {
            overview: ['概览', '首页 / 概览'],
            goals: ['学期目标', '首页 / 学期目标'],
            checkins: ['每日打卡', '首页 / 每日打卡'],
            mistakes: ['错题本', '首页 / 错题本'],
            points: ['积分管理', '首页 / 积分管理'],
            rewards: ['奖励配置', '首页 / 奖励配置'],
            review: ['周报复盘', '首页 / 周报复盘'],
            focus: ['专注计时', '首页 / 专注计时'],
            books: ['阅读书单', '首页 / 阅读书单'],
            calendar: ['学习日历', '首页 / 学习日历'],
            messages: ['家长留言', '首页 / 家长留言'],
            settings: ['任务配置', '首页 / 任务配置'],
            exams: ['试卷分析', '首页 / 试卷分析']
        };

        function switchPage(page) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById(`page-${page}`).classList.add('active');
            document.querySelector(`.nav-item[data-page="${page}"]`)?.classList.add('active');
            
            // 子菜单激活时，父级也高亮（任务配置 → 每日打卡）
            if (page === 'settings') {
                document.querySelector(`.nav-item[data-page="checkins"]`)?.classList.add('active');
            }
            
            const [title, breadcrumb] = pageTitles[page] || [page, page];
            document.getElementById('pageTitle').textContent = title;
            document.getElementById('pageBreadcrumb').textContent = breadcrumb;
            
            // 加载对应页面数据
            if (page === 'checkins') loadCheckinPage();
            if (page === 'settings') loadTaskConfigPage();
            if (page === 'points') loadPointsPage();
            if (page === 'rewards') loadRewardsPage();
            if (page === 'exams') loadExamPage();
            if (page === 'mistakes') loadMistakesPage();
            
            // 手机端切换页面后关闭菜单
            if (window.innerWidth <= 768) {
                closeMobileMenu();
            }
        }
        
        // 手机端菜单控制
        function toggleMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            sidebar.classList.toggle('mobile-open');
        }
        
        function closeMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            sidebar.classList.remove('mobile-open');
        }

        // ============ 每日打卡管理（家长端） ============

        function loadTaskConfigPage() {
            const today = getLocalDate();
            document.getElementById('taskConfigDate').value = today;
            loadTaskConfig();
        }

        function loadCheckinPage() {
            const today = getLocalDate();
            document.getElementById('checkinDate').value = today;
            loadCheckinDate();
        }

        async function loadCheckinDate() {
            const date = document.getElementById('checkinDate').value;
            if (!date) return;
            try {
                const [checkinRes, subRes] = await Promise.all([
                    fetch(`${API_BASE}/checkins/${date}?student_id=${studentId}`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    }),
                    fetch(`${API_BASE}/submissions?date=${date}&student_id=${studentId}`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    })
                ]);
                const data = await checkinRes.json();
                const submissions = await subRes.json();
                renderCheckinList(data, submissions || []);
            } catch (e) {
                console.error('加载打卡失败', e);
            }
        }

        function renderCheckinList(data, submissions) {
            const container = document.getElementById('checkinListContainer');

            // 初始化 qualityScores 从已保存的数据
            data.tasks.forEach(task => {
                if (task.quality !== null && task.quality !== undefined) {
                    qualityScores[task.id] = task.quality;
                }
                if (task.sub_tasks) {
                    task.sub_tasks.forEach(sub => {
                        if (sub.quality !== null && sub.quality !== undefined) {
                            qualityScores[sub.id] = sub.quality;
                        }
                    });
                }
            });

            // 按任务 id 索引当天提交记录
            const subMap = {};
            (submissions || []).forEach(s => { subMap[s.task_id] = s; });

            // 已提交徽标 + 提交按钮
            const subBadge = (sub) => {
                if (!sub) return '';
                const ai = sub.ai_result;
                if (ai && ai.status === 'graded') {
                    return `<span class="sub-badge graded" title="AI批改：${Math.round(ai.accuracy * 100)}%正确">📷 ${Math.round(ai.accuracy * 100)}分</span>`;
                }
                return `<span class="sub-badge">📷 已提交</span>`;
            };
            const photoBtn = (task, label) => {
                if (!task.needs_photo) return '';
                return `<button class="btn-submit-photo" onclick="event.stopPropagation();openSubmitModal(${task.id}, '${label.replace(/'/g, "\\'")}')">📷 提交</button>`;
            };

            // 质量评分组件（0/1/2 星）
            const qualityStars = (taskId, currentQuality) => {
                const q = currentQuality !== null && currentQuality !== undefined ? currentQuality : -1;
                let html = '<div class="quality-stars" onclick="event.stopPropagation()">';
                for (let i = 0; i <= 2; i++) {
                    const active = i <= q ? 'active' : '';
                    html += `<span class="q-star ${active}" data-task="${taskId}" data-quality="${i}" onclick="setQuality(${taskId}, ${i})">${i === 0 ? '✗' : i === 1 ? '⭐' : '⭐⭐'}</span>`;
                }
                html += '</div>';
                return html;
            };

            // 统计完成率
            let total = 0, completed = 0;
            data.tasks.forEach(task => {
                if (task.sub_tasks && task.sub_tasks.length > 0) {
                    task.sub_tasks.forEach(s => { total++; if (s.is_completed) completed++; });
                } else {
                    total++;
                    if (task.is_completed) completed++;
                }
            });
            const rate = total ? Math.round((completed / total) * 100) : 0;
            document.getElementById('checkinRate').textContent = `完成率 ${rate}% (${completed}/${total})`;

            let html = '';
            html += '<div id="sortableCheckinList">';
            data.tasks.forEach(task => {
                if (task.sub_tasks && task.sub_tasks.length > 0) {
                    // 分组任务
                    const subCompleted = task.sub_tasks.filter(s => s.is_completed).length;
                    const subTotal = task.sub_tasks.length;
                    html += `
                        <div class="checkin-group" data-task-id="${task.id}">
                            <div class="checkin-group-header">
                                <span class="drag-handle">⋮⋮</span>
                                <span>${task.icon}</span>
                                <span>${task.name}</span>
                                <span class="group-count">${subCompleted}/${subTotal}</span>
                            </div>
                            <div class="checkin-group-body">
                    `;
                    task.sub_tasks.forEach(sub => {
                        html += `
                            <div class="checkin-row ${sub.is_completed ? 'completed' : ''}" onclick="toggleParentCheckin(${sub.id}, ${sub.is_completed ? 0 : 1})">
                                <div class="check-box">${sub.is_completed ? '✓' : ''}</div>
                                <span class="task-icon">${sub.icon}</span>
                                <span class="task-name">${sub.name}</span>
                                ${subBadge(subMap[sub.id])}
                                ${photoBtn(sub, sub.name)}
                                ${sub.is_completed ? qualityStars(sub.id, sub.quality) : ''}
                            </div>
                        `;
                    });
                    html += `</div></div>`;
                } else {
                    // 普通任务
                    html += `
                        <div class="checkin-group" data-task-id="${task.id}">
                            <div class="checkin-group-body" style="border:1px solid #f0f0f0;border-radius:8px;">
                                <div class="checkin-row ${task.is_completed ? 'completed' : ''}" onclick="toggleParentCheckin(${task.id}, ${task.is_completed ? 0 : 1})">
                                    <span class="drag-handle">⋮⋮</span>
                                    <div class="check-box">${task.is_completed ? '✓' : ''}</div>
                                    <span class="task-icon">${task.icon}</span>
                                    <span class="task-name">${task.name}</span>
                                    ${subBadge(subMap[task.id])}
                                    ${photoBtn(task, task.name)}
                                    ${task.is_completed ? qualityStars(task.id, task.quality) : ''}
                                </div>
                            </div>
                        </div>
                    `;
                }
            });
            html += '</div>';

            // 底部保存评分和排序按钮
            html += `<div style="text-align:center;margin-top:16px;">
                <button class="btn-small" onclick="saveAllQualityScores()" style="background:var(--accent);padding:10px 28px;font-size:14px;">💾 保存今日评分</button>
                <span id="qualitySaveMsg" style="margin-left:10px;font-size:13px;color:var(--primary);"></span>
            </div>`;

            container.innerHTML = html || '<div class="empty-state"><div class="empty-icon">📋</div><p>当天无打卡任务</p></div>';

            // 初始化拖拽排序
            initSortable();
        }

        // 初始化 SortableJS
        function initSortable() {
            const sortableEl = document.getElementById('sortableCheckinList');
            if (!sortableEl) return;

            Sortable.create(sortableEl, {
                animation: 150,
                handle: '.drag-handle',
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                onEnd: function(evt) {
                    // 拖拽结束后显示保存按钮
                    showSaveSortButton();
                }
            });
        }

        // 显示保存排序按钮
        function showSaveSortButton() {
            let btn = document.getElementById('btnSaveSort');
            if (!btn) {
                const container = document.getElementById('checkinListContainer');
                const div = document.createElement('div');
                div.style.textAlign = 'center';
                div.style.marginTop = '10px';
                div.innerHTML = `<button id="btnSaveSort" class="btn-save-sort show" onclick="saveTaskSort()">💾 保存排序</button><span id="sortSaveMsg" style="margin-left:10px;font-size:13px;color:var(--primary);"></span>`;
                container.appendChild(div);
            } else {
                btn.classList.add('show');
            }
        }

        // 保存任务排序
        async function saveTaskSort() {
            const items = document.querySelectorAll('#sortableCheckinList .checkin-group');
            const sortOrders = [];
            items.forEach((item, index) => {
                const taskId = item.getAttribute('data-task-id');
                if (taskId) {
                    sortOrders.push({ task_id: parseInt(taskId), sort_order: index + 1 });
                }
            });

            try {
                const res = await fetch(`${API_BASE}/tasks/batch-sort`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ sort_orders: sortOrders })
                });
                const data = await res.json();
                if (data.success) {
                    const msg = document.getElementById('sortSaveMsg');
                    if (msg) {
                        msg.textContent = '✓ 排序已保存';
                        setTimeout(() => { msg.textContent = ''; }, 2000);
                    }
                    const btn = document.getElementById('btnSaveSort');
                    if (btn) btn.classList.remove('show');
                } else {
                    alert('保存排序失败: ' + (data.error || '未知错误'));
                }
            } catch (e) {
                console.error('保存排序失败', e);
                alert('保存排序失败，请重试');
            }
        }

        async function toggleParentCheckin(taskId, completed) {
            const date = document.getElementById('checkinDate').value;
            try {
                await fetch(`${API_BASE}/checkins`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify({
                        student_id: studentId,
                        task_id: taskId,
                        date: date,
                        is_completed: completed
                    })
                });
                loadCheckinDate();
            } catch (e) {
                console.error('更新打卡失败', e);
            }
        }

        // ============ 任务配置管理 ============

        async function loadTaskConfig() {
            const date = document.getElementById('taskConfigDate').value;
            if (!date) return;
            try {
                const res = await fetch(`${API_BASE}/tasks/by-date/${date}?student_id=${studentId}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                const tasks = data.tasks || [];

                // 填充模态框的大类下拉
                const parentSelect = document.getElementById('taskParent');
                parentSelect.innerHTML = '<option value="0">顶级任务（不分组）</option>' +
                    tasks.map(t => `<option value="${t.id}">${t.icon} ${t.name}</option>`).join('');

                // 渲染任务列表：大类分组 + 当天排期的子任务
                const container = document.getElementById('taskConfigList');
                let html = '';
                tasks.forEach(task => {
                    const subHtml = task.sub_tasks.map(sub => `
                        <div class="task-config-item child">
                            <span class="task-icon">${sub.icon}</span>
                            <div class="task-info">
                                <div class="task-name">${sub.name}</div>
                                <div class="task-meta">${sub.subject || ''} · ${sub.task_type || 'general'}${sub.is_completed ? ' · ✅ 已完成' : ''}</div>
                            </div>
                            <div class="task-actions">
                                <button class="btn-small secondary" onclick="showEditTaskModal(${sub.id})">编辑</button>
                                <button class="btn-small danger" onclick="removeSchedule(${sub.id})">移除</button>
                                <button class="btn-small danger" onclick="deleteTask(${sub.id}, '${sub.name.replace(/'/g, "\\'")}')">删除</button>
                            </div>
                        </div>
                    `).join('');
                    html += `
                        <div class="task-config-item">
                            <span class="task-icon">${task.icon}</span>
                            <div class="task-info">
                                <div class="task-name">${task.name}</div>
                                <div class="task-meta">${task.subject || ''} · 当天 ${task.sub_tasks.length} 个任务${task.has_schedule ? ' · 含大类任务' : ''}</div>
                            </div>
                            <div class="task-actions">
                                <button class="btn-small secondary" onclick="showEditTaskModal(${task.id})">编辑</button>
                                <button class="btn-small secondary" onclick="showAddTaskModal(${task.id})">+子任务</button>
                                ${task.has_schedule ? `<button class="btn-small danger" onclick="removeSchedule(${task.id})">移除</button>` : ''}
                                <button class="btn-small danger" onclick="deleteTask(${task.id}, '${task.name.replace(/'/g, "\\'")}')">删除</button>
                            </div>
                        </div>
                        ${subHtml}
                        ${task.sub_tasks.length === 0 && !task.has_schedule ? '<div class="task-config-empty">当天未安排任务</div>' : ''}
                    `;
                });
                container.innerHTML = html || '<div class="empty-state"><div class="empty-icon">⚙️</div><p>暂无任务，点击右上角新增</p></div>';
            } catch (e) {
                console.error('加载任务失败', e);
            }
        }

        // 移除某任务当天的排期（打卡记录），任务模板保留
        async function removeSchedule(taskId) {
            if (!confirm('确定移除该任务当天的排期吗？任务模板会保留，其他日期不受影响。')) return;
            const date = document.getElementById('taskConfigDate').value;
            try {
                await fetch(`${API_BASE}/checkins/${date}/${taskId}?student_id=${studentId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                loadTaskConfig();
            } catch (e) {
                alert('移除失败');
                console.error(e);
            }
        }

        // 删除任务模板（永久删除，所有日期的排期都会删除）
        async function deleteTask(taskId, taskName) {
            if (!confirm(`确定删除任务「${taskName}」吗？\n\n⚠️ 这将永久删除该任务，所有日期的排期都会清除！`)) return;
            try {
                const res = await fetch(`${API_BASE}/tasks/${taskId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();
                if (data.success) {
                    alert('删除成功');
                    loadTaskConfig();
                } else {
                    alert('删除失败');
                }
            } catch (e) {
                alert('删除失败');
                console.error(e);
            }
        }

        // ============ 作业提交 ============
        let submitTaskId = null;
        let submitDate = null;

        function openSubmitModal(taskId, taskName) {
            submitTaskId = taskId;
            submitDate = document.getElementById('checkinDate').value;
            document.getElementById('submitModalTitle').textContent = `📷 提交作业：${taskName}`;
            document.getElementById('submitPreview').innerHTML = '';
            document.getElementById('submitResult').style.display = 'none';
            document.getElementById('submitResult').innerHTML = '';
            document.getElementById('submitFileInput').value = '';
            document.getElementById('submitBtn').style.display = '';
            document.getElementById('submitBtn').disabled = false;
            document.getElementById('submitBtn').textContent = '提交作业';
            document.getElementById('submitModal').classList.add('active');
        }

        function closeSubmitModal() {
            document.getElementById('submitModal').classList.remove('active');
        }

        document.getElementById('submitFileInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (ev) => {
                document.getElementById('submitPreview').innerHTML = `<img src="${ev.target.result}" alt="作业预览">`;
            };
            reader.readAsDataURL(file);
        });

        async function uploadSubmission() {
            const fileInput = document.getElementById('submitFileInput');
            if (!fileInput.files[0]) { alert('请先选择照片'); return; }
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.textContent = '提交中...';
            const fd = new FormData();
            fd.append('image', fileInput.files[0]);
            fd.append('task_id', submitTaskId);
            fd.append('date', submitDate);
            fd.append('student_id', studentId);
            try {
                const res = await fetch(`${API_BASE}/submissions`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` },
                    body: fd
                });
                const data = await res.json().catch(() => null);
                if (!res.ok || !data) {
                    alert('提交失败：' + (data?.error || `服务器返回异常(${res.status})，请重试`));
                    return;
                }
                showSubmitResult(data);
                loadCheckinDate(); // 刷新打卡页显示已提交状态
            } catch (e) {
                alert('提交失败：网络错误，请检查网络后重试');
                console.error(e);
            }
            btn.disabled = false;
            btn.textContent = '提交作业';
        }

        function showSubmitResult(sub) {
            const box = document.getElementById('submitResult');
            box.style.display = 'block';
            const ai = sub.ai_result;
            if (ai && ai.status === 'graded') {
                const total = ai.total || 0;
                const correct = ai.correct || 0;
                const wrong = (ai.questions || []).filter(q => !q.correct);
                if (total > 0 && correct === total) {
                    // 全对
                    box.innerHTML = `<div style="margin-top:12px;padding:16px;background:#f6fff6;border:1px solid #d4edda;border-radius:8px;text-align:center;">
                        <div style="font-size:22px;">🎉</div>
                        <div style="font-size:16px;font-weight:700;color:#2e7d32;margin-top:4px;">太棒了！全部答对（${total}题）！</div>
                        <div style="font-size:13px;color:#888;margin-top:4px;">继续保持哦~</div>
                    </div>`;
                } else {
                    // 有错误：只显示错题，不给答案
                    let html = `<div style="margin-top:12px;padding:12px;background:#fff8f3;border:1px solid #f5d5b5;border-radius:8px;">
                        <div style="font-size:14px;font-weight:700;color:#e67e22;">📊 共 ${total} 题 · 答对 ${correct} 题${wrong.length ? ` · ${wrong.length} 题需要订正` : ''}</div>
                        <div style="font-size:12px;color:#aaa;margin-top:2px;">${sub.mistake_added ? '📝 错题已加入错题本' : '订正后记得重新提交哦'}</div>`;
                    wrong.forEach(q => {
                        html += `<div style="margin-top:8px;padding:8px 10px;background:#fff;border:1px solid #f5c6cb;border-radius:6px;font-size:13px;color:#c0392b;">
                            ❌ ${q.q || ''} <span style="color:#e67e22;">= ${q.student_answer || '未作答'}</span>
                            ${q.note ? `<div style="font-size:12px;color:#aaa;margin-top:2px;">${q.note}</div>` : ''}
                        </div>`;
                    });
                    html += '</div>';
                    box.innerHTML = html;
                }
            } else if (ai && ai.status === 'failed') {
                box.innerHTML = `<div style="margin-top:12px;padding:12px;background:#fff3f3;border:1px solid #f5c6cb;border-radius:8px;font-size:13px;color:#c0392b;">⚠️ AI 批改失败：${ai.error || '未知错误'}。照片已保存，可重新提交。</div>`;
            } else {
                box.innerHTML = `<div style="margin-top:12px;padding:12px;background:#f0f7ff;border:1px solid #bee5eb;border-radius:8px;font-size:13px;color:#0c5460;">📷 作业已提交，等待老师查看。</div>`;
            }
        }

        let editingTaskId = null;
        let addParentId = 0;

        function showAddTaskModal(parentId = 0) {
            editingTaskId = null;
            addParentId = parentId;
            document.getElementById('taskModalTitle').textContent = '新增任务';
            document.getElementById('taskName').value = '';
            document.getElementById('taskIcon').value = '';
            document.getElementById('taskDescription').value = '';
            document.getElementById('taskType').value = 'general';
            document.getElementById('taskParent').value = parentId;
            document.getElementById('taskModal').classList.add('active');
        }

        function showEditTaskModal(taskId) {
            // 从当前列表数据中查找任务
            fetch(`${API_BASE}/tasks`, { headers: { 'Authorization': `Bearer ${token}` } })
                .then(r => r.json())
                .then(tasks => {
                    let task = null;
                    tasks.forEach(t => {
                        if (t.id === taskId) task = t;
                        t.sub_tasks.forEach(s => { if (s.id === taskId) task = s; });
                    });
                    if (!task) return;
                    editingTaskId = taskId;
                    addParentId = 0;
                    document.getElementById('taskModalTitle').textContent = '编辑任务';
                    document.getElementById('taskName').value = task.name;
                    document.getElementById('taskIcon').value = task.icon || '';
                    document.getElementById('taskDescription').value = task.description || '';
                    document.getElementById('taskType').value = task.task_type || 'general';
                    document.getElementById('taskParent').value = task.parent_id || 0;
                    document.getElementById('taskModal').classList.add('active');
                });
        }

        function closeTaskModal() {
            document.getElementById('taskModal').classList.remove('active');
        }

        async function saveTask() {
            const name = document.getElementById('taskName').value.trim();
            if (!name) { alert('请输入任务名称'); return; }

            const payload = {
                name,
                parent_id: parseInt(document.getElementById('taskParent').value),
                subject: document.getElementById('taskSubject').value,
                icon: document.getElementById('taskIcon').value.trim() || '📝',
                task_type: document.getElementById('taskType').value,
                description: document.getElementById('taskDescription').value.trim()
            };

            try {
                if (editingTaskId) {
                    await fetch(`${API_BASE}/tasks/${editingTaskId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                        body: JSON.stringify(payload)
                    });
                } else {
                    const res = await fetch(`${API_BASE}/tasks`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                        body: JSON.stringify(payload)
                    });
                    const savedTask = await res.json();
                    // 新增任务自动排期到配置页选中的日期
                    const configDate = document.getElementById('taskConfigDate').value;
                    if (configDate && savedTask.id) {
                        await fetch(`${API_BASE}/checkins`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                            body: JSON.stringify({
                                student_id: studentId,
                                task_id: savedTask.id,
                                date: configDate,
                                is_completed: 0
                            })
                        });
                    }
                }
                closeTaskModal();
                loadTaskConfig();
            } catch (e) {
                alert('保存失败');
                console.error(e);
            }
        }

        async function deleteTask(taskId) {
            if (!confirm('确定删除该任务吗？')) return;
            try {
                await fetch(`${API_BASE}/tasks/${taskId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                loadTaskConfig();
            } catch (e) {
                alert('删除失败');
                console.error(e);
            }
        }

        async function loadOverview() {
            // KPI
            try {
                const res = await fetch(`${API_BASE}/stats/dashboard?student_id=${studentId}`, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                document.getElementById('kpiRate').textContent = data.today_rate + '%';
                document.getElementById('kpiStreak').textContent = data.streak + '天';
                document.getElementById('kpiMistakes').textContent = data.week_mistakes;
                document.getElementById('kpiMessages').textContent = data.unread_messages;
                document.getElementById('kpiTrend').textContent = data.today_rate >= 80 ? '↑ 优秀' : data.today_rate >= 50 ? '→ 加油' : '↓ 需努力';
            } catch (e) { console.error(e); }

            // 目标进度
            try {
                const res = await fetch(`${API_BASE}/stats/subjects?student_id=${studentId}`, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                const icons = { '语文': '📖', '数学': '🔢', '英语': '🔤', 'OD': '📗' };
                const classes = { '语文': 'chinese', '数学': 'math', '英语': 'english', 'OD': 'od' };
                const colors = ['green', 'blue', 'orange', 'red'];
                const container = document.getElementById('goalProgress');
                container.innerHTML = data.map((s, i) => {
                    const pct = s.total_checkins ? Math.round((s.completed / s.total_checkins) * 100) : 0;
                    return `<div class="goal-item">
                        <div class="goal-icon ${classes[s.subject] || ''}">${icons[s.subject] || '📝'}</div>
                        <div class="goal-info">
                            <div class="goal-name">${s.subject}</div>
                            <div class="goal-bar"><div class="fill ${colors[i % 4]}" style="width:${pct}%"></div></div>
                        </div>
                        <div class="goal-percent">${pct}%</div>
                    </div>`;
                }).join('');
            } catch (e) { console.error(e); }

            // 今日打卡
            try {
                const res = await fetch(`${API_BASE}/checkins/today?student_id=${studentId}`, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                const container = document.getElementById('todayCheckins');
                container.innerHTML = data.tasks.map(task => `
                    <div class="checkin-item ${task.is_completed ? 'completed' : ''}" onclick="toggleCheckin(${task.id}, ${task.is_completed ? 0 : 1})">
                        <div class="check-box">${task.is_completed ? '✓' : ''}</div>
                        <span class="task-icon">${task.icon}</span>
                        <span class="task-name">${task.name}</span>
                    </div>
                `).join('');
            } catch (e) { console.error(e); }

            // 错题分布
            try {
                const res = await fetch(`${API_BASE}/mistakes/stats?student_id=${studentId}`, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                const container = document.getElementById('mistakeChart');
                if (data.length === 0) {
                    container.innerHTML = '<div class="empty-state"><p>暂无错题记录</p></div>';
                } else {
                    const maxCount = Math.max(...data.map(d => d.total));
                    const barColors = ['#c0392b', '#e67e22', '#3498db', '#27ae60'];
                    container.innerHTML = data.map((s, i) => `
                        <div class="mistake-row">
                            <span class="subject">${s.subject}</span>
                            <div class="bar-wrap">
                                <div class="bar-fill" style="width:${(s.total/maxCount)*100}%;background:${barColors[i%4]}">${s.total}</div>
                            </div>
                            <span class="count">${s.total}道</span>
                        </div>
                    `).join('');
                }
            } catch (e) { console.error(e); }

            // 留言
            loadMessages();
            
            // 热力图
            generateHeatmap();
        }

        async function toggleCheckin(taskId, completed) {
            const today = getLocalDate();
            try {
                await fetch(`${API_BASE}/checkins`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify({ student_id: studentId, task_id: taskId, date: today, is_completed: completed })
                });
                loadOverview();
            } catch (e) { console.error(e); }
        }

        async function loadMessages() {
            try {
                const res = await fetch(`${API_BASE}/messages`, { headers: { 'Authorization': `Bearer ${token}` } });
                const data = await res.json();
                const container = document.getElementById('messageList');
                if (data.length === 0) {
                    container.innerHTML = '<div class="empty-state"><p>还没有留言，写一句鼓励的话吧~</p></div>';
                } else {
                    container.innerHTML = data.slice(0, 5).map(m => `
                        <div class="message-item">
                            <div class="msg-content">${m.content}</div>
                            <div class="msg-time">${new Date(m.created_at).toLocaleString('zh-CN')}</div>
                        </div>
                    `).join('');
                }
            } catch (e) { console.error(e); }
        }

        async function sendMessage() {
            const input = document.getElementById('messageInput');
            const content = input.value.trim();
            if (!content) return;
            try {
                await fetch(`${API_BASE}/messages`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify({ content })
                });
                input.value = '';
                loadMessages();
            } catch (e) { console.error(e); }
        }

        // 本月打卡热力图（真实月历模式）
        async function generateHeatmap() {
            const container = document.getElementById('heatmap');
            const now = new Date();
            const year = now.getFullYear();
            const month = now.getMonth() + 1;
            const monthStr = `${year}-${String(month).padStart(2, '0')}`;

            // 获取当月真实打卡数据（后端 /api/checkins/calendar）
            let stats = [];
            try {
                const res = await fetch(`${API_BASE}/checkins/calendar?month=${monthStr}&student_id=${studentId}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                stats = await res.json();
            } catch (e) {
                console.error('加载月历数据失败', e);
            }

            const statMap = {};
            (stats || []).forEach(s => {
                const day = parseInt(s.date.split('-')[2]);
                statMap[day] = s;
            });

            // 当月第一天是星期几，按周一开头计算偏移
            const firstDay = new Date(year, month - 1, 1).getDay(); // 0=周日
            const offset = (firstDay + 6) % 7; // 周一=0 ... 周日=6
            const daysInMonth = new Date(year, month, 0).getDate();
            const today = now.getDate();

            // 完成率 → 颜色等级
            const levelOf = (s) => {
                if (!s || s.total === 0) return { level: 0, rate: 0 };
                const rate = s.completed / s.total;
                const level = rate >= 1 ? 4 : rate >= 0.67 ? 3 : rate >= 0.34 ? 2 : rate > 0 ? 1 : 0;
                return { level, rate: Math.round(rate * 100) };
            };

            const isWeekend = (day) => {
                const d = new Date(year, month - 1, day).getDay();
                return d === 0 || d === 6;
            };

            // 周几表头（周一开头，周末高亮）
            let html = '<div class="cal-header">' +
                ['一', '二', '三', '四', '五', '六', '日']
                    .map((w, i) => `<span class="${i >= 5 ? 'weekend' : ''}">${w}</span>`).join('') +
                '</div><div class="cal-grid">';

            // 月初占位（对齐到正确的星期）
            for (let i = 0; i < offset; i++) {
                html += '<div class="cal-cell empty"></div>';
            }

            // 每天一个格子：日期数字 + 完成率颜色
            for (let day = 1; day <= daysInMonth; day++) {
                const s = statMap[day];
                const { level, rate } = levelOf(s);
                const cls = [
                    'cal-cell',
                    `level-${level}`,
                    day === today ? 'today' : '',
                    isWeekend(day) ? 'weekend' : ''
                ].filter(Boolean).join(' ');
                const title = s && s.total > 0
                    ? `${month}月${day}日 完成率${rate}% (${s.completed}/${s.total})`
                    : `${month}月${day}日 无任务`;
                html += `<div class="${cls}" title="${title}">${day}</div>`;
            }

            html += '</div>';

            // 图例
            html += `<div class="cal-legend">
                <span>完成率</span>
                <span class="legend-dot level-1"></span>
                <span class="legend-dot level-2"></span>
                <span class="legend-dot level-3"></span>
                <span class="legend-dot level-4"></span>
            </div>`;

            container.innerHTML = html;
        }

        // ============ 质量评分（积分系统） ============
        const qualityScores = {}; // { taskId: quality }

        function setQuality(taskId, quality) {
            qualityScores[taskId] = quality;
            // 更新 UI
            document.querySelectorAll(`.q-star[data-task="${taskId}"]`).forEach(star => {
                const q = parseInt(star.dataset.quality);
                star.classList.toggle('active', q <= quality);
            });
        }

        async function saveAllQualityScores() {
            const date = document.getElementById('checkinDate').value;
            if (!date) return;

            const scores = Object.entries(qualityScores).map(([task_id, quality]) => ({
                task_id: parseInt(task_id),
                quality
            }));

            if (scores.length === 0) {
                alert('请先为已完成的任务评分');
                return;
            }

            try {
                const res = await fetch(`${API_BASE}/checkins/quality`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ date, scores, student_id: studentId })
                });

                if (res.ok) {
                    const data = await res.json();
                    document.getElementById('qualitySaveMsg').textContent = `✓ 已保存，今日获得 ${data.daily_total} 分`;
                    setTimeout(() => {
                        document.getElementById('qualitySaveMsg').textContent = '';
                    }, 3000);
                } else {
                    alert('保存失败');
                }
            } catch (e) {
                console.error('保存评分失败', e);
                alert('保存失败');
            }
        }

        // ============ 积分管理页面 ============
        async function loadPointsPage() {
            try {
                // 获取余额
                const balanceRes = await fetch(`${API_BASE}/points/balance?student_id=${studentId}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const balanceData = await balanceRes.json();
                document.getElementById('pointsBalance').textContent = `${balanceData.balance} 分`;

                // 获取流水
                const ledgerRes = await fetch(`${API_BASE}/points/ledger?student_id=${studentId}&limit=50`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const ledger = await ledgerRes.json();

                const container = document.getElementById('pointsLedger');
                if (ledger.length === 0) {
                    container.innerHTML = '<div class="empty-state"><p>暂无积分记录</p></div>';
                } else {
                    container.innerHTML = ledger.map(entry => {
                        const icon = entry.points > 0 ? '🎉' : '🎁';
                        const color = entry.points > 0 ? 'var(--primary)' : 'var(--accent)';
                        const sign = entry.points > 0 ? '+' : '';
                        return `
                            <div style="display:flex;justify-content:space-between;align-items:center;padding:12px;border-bottom:1px solid var(--border);">
                                <div>
                                    <div style="font-size:14px;font-weight:500;">${icon} ${entry.description}</div>
                                    <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">${new Date(entry.created_at).toLocaleString('zh-CN')}</div>
                                </div>
                                <div style="font-size:16px;font-weight:600;color:${color};">${sign}${entry.points}</div>
                            </div>
                        `;
                    }).join('');
                }
            } catch (e) {
                console.error('加载积分页面失败', e);
            }
        }

        async function checkWeeklyBonus() {
            try {
                const res = await fetch(`${API_BASE}/points/weekly-check?student_id=${studentId}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();

                const container = document.getElementById('weeklyBonusResult');
                container.style.display = 'block';

                if (data.eligible) {
                    container.innerHTML = `
                        <div style="background:var(--primary-light);padding:16px;border-radius:8px;border-left:4px solid var(--primary);">
                            <div style="font-size:15px;font-weight:600;color:var(--primary);margin-bottom:8px;">🎉 周全勤奖励已发放！</div>
                            <div style="font-size:14px;">本周获得 <strong>+10 分</strong>，当前余额 <strong>${data.balance} 分</strong></div>
                        </div>
                    `;
                    loadPointsPage(); // 刷新页面
                } else {
                    container.innerHTML = `
                        <div style="background:var(--accent-light);padding:16px;border-radius:8px;border-left:4px solid var(--accent);">
                            <div style="font-size:15px;font-weight:600;color:var(--accent);margin-bottom:8px;">📋 本周全勤检查</div>
                            <div style="font-size:14px;">${data.reason}</div>
                            ${data.daily_details ? `<div style="margin-top:8px;font-size:13px;color:var(--text-secondary);">
                                ${data.daily_details.map(d => `${d.date}: ${d.status === 'qualified' ? '✓ 达标' : d.status === 'exempt' ? '⚠ 豁免' : '✗ 未达标'} (${d.count}项)`).join('<br>')}
                            </div>` : ''}
                        </div>
                    `;
                }
            } catch (e) {
                console.error('检查全勤失败', e);
                alert('检查失败');
            }
        }

        // ============ 奖励配置页面 ============
        let editingRewardId = null;

        async function loadRewardsPage() {
            try {
                const res = await fetch(`${API_BASE}/rewards`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const rewards = await res.json();

                const container = document.getElementById('rewardsList');
                if (rewards.length === 0) {
                    container.innerHTML = '<div class="empty-state"><p>暂无奖励配置</p></div>';
                } else {
                    container.innerHTML = rewards.map(reward => `
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:16px;border-bottom:1px solid var(--border);">
                            <div style="display:flex;align-items:center;gap:12px;">
                                <div style="font-size:32px;">${reward.icon}</div>
                                <div>
                                    <div style="font-size:15px;font-weight:500;">${reward.name}</div>
                                    <div style="font-size:13px;color:var(--text-muted);margin-top:2px;">${reward.description || ''}</div>
                                    <div style="font-size:14px;font-weight:600;color:var(--accent);margin-top:4px;">${reward.cost} 分</div>
                                </div>
                            </div>
                            <div style="display:flex;gap:8px;">
                                <button class="btn-small secondary" onclick="editReward(${reward.id})">编辑</button>
                                <button class="btn-small danger" onclick="deleteReward(${reward.id})">删除</button>
                            </div>
                        </div>
                    `).join('');
                }
            } catch (e) {
                console.error('加载奖励列表失败', e);
            }
        }

        function showAddRewardModal() {
            editingRewardId = null;
            document.getElementById('rewardModalTitle').textContent = '新增奖励';
            document.getElementById('rewardName').value = '';
            document.getElementById('rewardCost').value = '';
            document.getElementById('rewardIcon').value = '';
            document.getElementById('rewardDesc').value = '';
            document.getElementById('rewardModal').classList.add('active');
        }

        async function editReward(id) {
            try {
                const res = await fetch(`${API_BASE}/rewards`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const rewards = await res.json();
                const reward = rewards.find(r => r.id === id);
                if (!reward) return;

                editingRewardId = id;
                document.getElementById('rewardModalTitle').textContent = '编辑奖励';
                document.getElementById('rewardName').value = reward.name;
                document.getElementById('rewardCost').value = reward.cost;
                document.getElementById('rewardIcon').value = reward.icon;
                document.getElementById('rewardDesc').value = reward.description || '';
                document.getElementById('rewardModal').classList.add('active');
            } catch (e) {
                console.error('加载奖励失败', e);
            }
        }

        function closeRewardModal() {
            document.getElementById('rewardModal').classList.remove('active');
            editingRewardId = null;
        }

        async function saveReward() {
            const name = document.getElementById('rewardName').value.trim();
            const cost = parseInt(document.getElementById('rewardCost').value);
            const icon = document.getElementById('rewardIcon').value.trim() || '🎁';
            const description = document.getElementById('rewardDesc').value.trim();

            if (!name || !cost || cost < 1) {
                alert('请填写完整的奖励名称和积分');
                return;
            }

            try {
                const url = editingRewardId ? `${API_BASE}/rewards/${editingRewardId}` : `${API_BASE}/rewards`;
                const method = editingRewardId ? 'PUT' : 'POST';

                const res = await fetch(url, {
                    method,
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ name, cost, icon, description })
                });

                if (res.ok) {
                    closeRewardModal();
                    loadRewardsPage();
                } else {
                    alert('保存失败');
                }
            } catch (e) {
                console.error('保存奖励失败', e);
                alert('保存失败');
            }
        }

        async function deleteReward(id) {
            if (!confirm('确定要删除这个奖励吗？')) return;

            try {
                const res = await fetch(`${API_BASE}/rewards/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                if (res.ok) {
                    loadRewardsPage();
                } else {
                    alert('删除失败');
                }
            } catch (e) {
                console.error('删除奖励失败', e);
                alert('删除失败');
            }
        }

        // ============ 试卷分析功能 ============

        async function loadExamPage() {
            await loadExamList();
            await loadExamTrend();
        }

        async function loadExamList() {
            const subject = document.getElementById('examSubjectFilter').value;
            const examType = document.getElementById('examTypeFilter').value;
            
            let url = `${API_BASE}/exams?student_id=${studentId}`;
            if (subject) url += `&subject=${subject}`;
            if (examType) url += `&exam_type=${examType}`;

            try {
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const exams = await res.json();
                renderExamList(exams);
            } catch (e) {
                console.error('加载试卷列表失败', e);
            }
        }

        function renderExamList(exams) {
            const container = document.getElementById('examListContainer');
            
            if (exams.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">📄</div>
                        <p>暂无试卷记录</p>
                    </div>
                `;
                return;
            }

            const html = exams.map(exam => {
                const accuracy = exam.accuracy ? Math.round(exam.accuracy * 100) : 0;
                const accuracyClass = accuracy >= 90 ? 'accuracy-high' : accuracy >= 70 ? 'accuracy-mid' : 'accuracy-low';
                
                return `
                    <div class="exam-item" onclick="showExamDetail(${exam.id})">
                        <div class="exam-item-header">
                            <div>
                                <div class="exam-item-title">${exam.title}</div>
                                <div class="exam-item-meta">
                                    <span class="tag tag-subject">${exam.subject}</span>
                                    <span class="tag tag-type">${exam.exam_type}</span>
                                    <span>${exam.exam_date}</span>
                                    <span>${exam.total_questions}题 · 对${exam.correct_count}题</span>
                                </div>
                            </div>
                            <div class="exam-accuracy ${accuracyClass}">${accuracy}%</div>
                        </div>
                    </div>
                `;
            }).join('');

            container.innerHTML = `<div class="exam-list">${html}</div>`;
        }

        async function showExamDetail(examId) {
            try {
                const res = await fetch(`${API_BASE}/exams/${examId}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const exam = await res.json();
                renderExamDetail(exam);
            } catch (e) {
                console.error('加载试卷详情失败', e);
            }
        }

        function renderExamDetail(exam) {
            const accuracy = exam.accuracy ? Math.round(exam.accuracy * 100) : 0;
            const accuracyClass = accuracy >= 90 ? 'accuracy-high' : accuracy >= 70 ? 'accuracy-mid' : 'accuracy-low';

            const questionsHtml = exam.questions.map(q => {
                const statusClass = q.is_correct ? 'correct' : 'wrong';
                const statusIcon = q.is_correct ? '✓' : '✗';
                const errorInfo = !q.is_correct ? `
                    <div class="exam-q-error">
                        ${q.error_type ? `错误类型：${q.error_type}` : ''}
                        ${q.knowledge_point ? ` · 知识点：${q.knowledge_point}` : ''}
                    </div>
                ` : '';

                return `
                    <div class="exam-question-item ${statusClass}">
                        <div class="exam-q-num">${statusIcon} ${q.question_num}</div>
                        <div class="exam-q-content">
                            <div>${q.question_content}</div>
                            <div class="exam-q-answer">
                                学生答案：${q.student_answer || '未作答'} 
                                ${!q.is_correct ? `· 正确答案：${q.correct_answer}` : ''}
                            </div>
                            ${errorInfo}
                        </div>
                    </div>
                `;
            }).join('');

            const modalHtml = `
                <div class="exam-modal-overlay active" onclick="closeExamDetail(event)">
                    <div class="exam-modal" onclick="event.stopPropagation()">
                        <div class="exam-modal-header">
                            <div>
                                <h3>${exam.title}</h3>
                                <div class="exam-item-meta" style="margin-top: 8px;">
                                    <span class="tag tag-subject">${exam.subject}</span>
                                    <span class="tag tag-type">${exam.exam_type}</span>
                                    <span>${exam.exam_date}</span>
                                </div>
                            </div>
                            <div>
                                <div class="exam-accuracy ${accuracyClass}" style="font-size: 24px;">${accuracy}%</div>
                                <button class="exam-modal-close" onclick="closeExamDetail()">&times;</button>
                            </div>
                        </div>
                        <div class="exam-question-list">
                            ${questionsHtml}
                        </div>
                        ${exam.summary ? `<div class="exam-summary-box"><strong>AI分析：</strong>${exam.summary}</div>` : ''}
                    </div>
                </div>
            `;

            document.body.insertAdjacentHTML('beforeend', modalHtml);
        }

        function closeExamDetail(event) {
            if (event && event.target && !event.target.classList.contains('exam-modal-overlay')) return;
            const overlay = document.querySelector('.exam-modal-overlay.active');
            if (overlay) overlay.remove();
        }

        function showUploadExamModal() {
            const modalHtml = `
                <div class="upload-exam-modal-overlay active" id="uploadExamModal" onclick="closeUploadExamModal(event)">
                    <div class="upload-exam-modal" onclick="event.stopPropagation()">
                        <h3>上传试卷</h3>
                        <form class="upload-exam-form" onsubmit="handleUploadExam(event)">
                            <div class="form-group">
                                <label>科目</label>
                                <select id="uploadExamSubject" required>
                                    <option value="">请选择科目</option>
                                    <option value="语文">语文</option>
                                    <option value="数学">数学</option>
                                    <option value="英语">英语</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>类型</label>
                                <select id="uploadExamType" required>
                                    <option value="">请选择类型</option>
                                    <option value="考试">考试</option>
                                    <option value="练习册">练习册</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>考试日期</label>
                                <input type="date" id="uploadExamDate" required>
                            </div>
                            <div class="form-group">
                                <label>试卷标题（可选）</label>
                                <input type="text" id="uploadExamTitle" placeholder="如：第三单元测试">
                            </div>
                            <div class="form-group">
                                <label>上传照片</label>
                                <input type="file" id="uploadExamImage" accept="image/*" required>
                            </div>
                            <button type="submit" class="btn-upload-exam" id="uploadExamBtn">上传并分析</button>
                        </form>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', modalHtml);
            document.getElementById('uploadExamDate').valueAsDate = new Date();
        }

        function closeUploadExamModal(event) {
            if (event && event.target && !event.target.classList.contains('upload-exam-modal-overlay')) return;
            const modal = document.getElementById('uploadExamModal');
            if (modal) modal.remove();
        }

        async function handleUploadExam(event) {
            event.preventDefault();
            
            const subject = document.getElementById('uploadExamSubject').value;
            const examType = document.getElementById('uploadExamType').value;
            const examDate = document.getElementById('uploadExamDate').value;
            const title = document.getElementById('uploadExamTitle').value;
            const imageFile = document.getElementById('uploadExamImage').files[0];

            if (!subject || !examType || !examDate || !imageFile) {
                alert('请填写完整信息');
                return;
            }

            const btn = document.getElementById('uploadExamBtn');
            btn.disabled = true;
            btn.textContent = '正在上传和分析...';

            const formData = new FormData();
            formData.append('student_id', studentId);
            formData.append('subject', subject);
            formData.append('exam_type', examType);
            formData.append('exam_date', examDate);
            formData.append('title', title);
            formData.append('image', imageFile);

            try {
                const res = await fetch(`${API_BASE}/exams`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` },
                    body: formData
                });

                if (res.ok) {
                    closeUploadExamModal();
                    await loadExamPage();
                    alert('试卷分析完成！');
                } else {
                    const err = await res.json();
                    alert(`上传失败：${err.error || '未知错误'}`);
                }
            } catch (e) {
                console.error('上传试卷失败', e);
                alert('上传失败');
            } finally {
                btn.disabled = false;
                btn.textContent = '上传并分析';
            }
        }

        async function loadExamTrend() {
            const subjects = ['语文', '数学', '英语'];
            const trendData = {};

            for (const subject of subjects) {
                try {
                    const res = await fetch(`${API_BASE}/exams/trend/${subject}?student_id=${studentId}`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const data = await res.json();
                    if (data.length > 0) {
                        trendData[subject] = data;
                    }
                } catch (e) {
                    console.error(`加载${subject}趋势失败`, e);
                }
            }

            renderExamTrend(trendData);
        }

        function renderExamTrend(trendData) {
            const container = document.getElementById('examTrendContainer');
            const subjects = Object.keys(trendData);

            if (subjects.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">📊</div>
                        <p>上传试卷后查看趋势</p>
                    </div>
                `;
                return;
            }

            const html = subjects.map(subject => {
                const data = trendData[subject];
                const maxAccuracy = Math.max(...data.map(d => d.accuracy || 0));
                
                const barsHtml = data.map(d => {
                    const accuracy = d.accuracy || 0;
                    const height = maxAccuracy > 0 ? (accuracy / maxAccuracy * 100) : 0;
                    const color = accuracy >= 0.9 ? 'var(--primary)' : accuracy >= 0.7 ? 'var(--accent)' : 'var(--danger)';
                    const date = d.exam_date.slice(5); // MM-DD
                    
                    return `
                        <div class="trend-bar" style="height: ${height}%; background: ${color};" title="${d.exam_date}: ${Math.round(accuracy * 100)}%">
                            <div class="trend-bar-label">${date}</div>
                        </div>
                    `;
                }).join('');

                return `
                    <div class="trend-subject-row">
                        <div class="trend-subject-label">${subject}</div>
                        <div class="trend-bars">${barsHtml}</div>
                    </div>
                `;
            }).join('');

            container.innerHTML = `<div class="trend-chart-container">${html}</div>`;
        }

        // ============ 错题本功能 ============
        
        async function loadMistakesPage() {
            await loadMistakeStats();
            await loadMistakeList();
        }

        async function loadMistakeStats() {
            try {
                const res = await fetch(`${API_BASE}/mistakes/stats?student_id=${studentId}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const stats = await res.json();
                renderMistakeStats(stats);
            } catch (e) {
                console.error('加载错题统计失败', e);
            }
        }

        function renderMistakeStats(stats) {
            const container = document.getElementById('mistakeStats');
            if (!stats || stats.length === 0) {
                container.innerHTML = '';
                return;
            }

            const total = stats.reduce((sum, s) => sum + s.total, 0);
            const corrected = stats.reduce((sum, s) => sum + s.corrected, 0);
            const uncorrected = total - corrected;

            const html = `
                <div class="mistake-stat-card">
                    <div class="mistake-stat-value">${total}</div>
                    <div class="mistake-stat-label">总错题数</div>
                </div>
                <div class="mistake-stat-card">
                    <div class="mistake-stat-value" style="color: var(--danger);">${uncorrected}</div>
                    <div class="mistake-stat-label">未订正</div>
                </div>
                <div class="mistake-stat-card">
                    <div class="mistake-stat-value" style="color: var(--primary);">${corrected}</div>
                    <div class="mistake-stat-label">已订正</div>
                </div>
                <div class="mistake-stat-card">
                    <div class="mistake-stat-value">${total > 0 ? Math.round(corrected / total * 100) : 0}%</div>
                    <div class="mistake-stat-label">订正率</div>
                </div>
            `;
            container.innerHTML = html;
        }

        async function loadMistakeList() {
            const subject = document.getElementById('mistakeSubjectFilter').value;
            const status = document.getElementById('mistakeStatusFilter').value;

            let url = `${API_BASE}/mistakes?student_id=${studentId}`;
            if (subject) url += `&subject=${subject}`;
            if (status !== '') url += `&is_corrected=${status}`;

            try {
                const res = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const mistakes = await res.json();
                renderMistakeList(mistakes);
            } catch (e) {
                console.error('加载错题列表失败', e);
            }
        }

        function renderMistakeList(mistakes) {
            const container = document.getElementById('mistakeListContainer');
            
            if (!mistakes || mistakes.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">📝</div>
                        <p>暂无错题记录</p>
                    </div>
                `;
                return;
            }

            const html = mistakes.map(m => {
                const statusClass = m.is_corrected ? 'corrected' : 'uncorrected';
                const statusText = m.is_corrected ? '已订正' : '未订正';
                const itemClass = m.is_corrected ? 'corrected' : '';
                
                return `
                    <div class="mistake-item ${itemClass}">
                        <div class="mistake-item-header">
                            <span class="mistake-subject-tag">${m.subject}</span>
                            <span class="mistake-status-tag ${statusClass}">${statusText}</span>
                        </div>
                        <div class="mistake-topic">${m.topic || '未分类'}</div>
                        <div class="mistake-description">${m.description}</div>
                        ${m.error_reason ? `<div class="mistake-reason">错误原因：${m.error_reason}</div>` : ''}
                        <div class="mistake-reason">创建时间：${new Date(m.created_at).toLocaleString('zh-CN')}</div>
                        <div class="mistake-actions">
                            ${m.is_corrected 
                                ? `<button class="mistake-btn uncorrect" onclick="toggleMistakeStatus(${m.id}, false)">标记为未订正</button>`
                                : `<button class="mistake-btn correct" onclick="toggleMistakeStatus(${m.id}, true)">标记为已订正</button>`
                            }
                        </div>
                    </div>
                `;
            }).join('');

            container.innerHTML = `<div class="mistake-list">${html}</div>`;
        }

        async function toggleMistakeStatus(id, isCorrected) {
            try {
                const res = await fetch(`${API_BASE}/mistakes/${id}`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ is_corrected: isCorrected ? 1 : 0 })
                });

                if (res.ok) {
                    await loadMistakesPage();
                } else {
                    alert('更新失败');
                }
            } catch (e) {
                console.error('更新错题状态失败', e);
                alert('更新失败');
            }
        }

        function showAddMistakeModal() {
            const modalHtml = `
                <div class="upload-exam-modal-overlay active" id="addMistakeModal" onclick="closeAddMistakeModal(event)">
                    <div class="upload-exam-modal" onclick="event.stopPropagation()">
                        <h3>添加错题</h3>
                        <form class="upload-exam-form" onsubmit="handleAddMistake(event)">
                            <div class="form-group">
                                <label>科目</label>
                                <select id="mistakeSubject" required>
                                    <option value="">请选择科目</option>
                                    <option value="语文">语文</option>
                                    <option value="数学">数学</option>
                                    <option value="英语">英语</option>
                                    <option value="其他">其他</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>题目分类</label>
                                <input type="text" id="mistakeTopic" placeholder="如：分数加减法、一般过去时" required>
                            </div>
                            <div class="form-group">
                                <label>题目内容</label>
                                <textarea id="mistakeDescription" rows="3" placeholder="输入题目内容" required style="width: 100%; padding: 10px 12px; border: 1.5px solid var(--border); border-radius: 8px; font-size: 14px; font-family: inherit;"></textarea>
                            </div>
                            <div class="form-group">
                                <label>错误原因（可选）</label>
                                <textarea id="mistakeErrorReason" rows="2" placeholder="分析错误原因" style="width: 100%; padding: 10px 12px; border: 1.5px solid var(--border); border-radius: 8px; font-size: 14px; font-family: inherit;"></textarea>
                            </div>
                            <button type="submit" class="btn-upload-exam" id="addMistakeBtn">添加错题</button>
                        </form>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', modalHtml);
        }

        function closeAddMistakeModal(event) {
            if (event && event.target && !event.target.classList.contains('upload-exam-modal-overlay')) return;
            const modal = document.getElementById('addMistakeModal');
            if (modal) modal.remove();
        }

        async function handleAddMistake(event) {
            event.preventDefault();
            
            const subject = document.getElementById('mistakeSubject').value;
            const topic = document.getElementById('mistakeTopic').value;
            const description = document.getElementById('mistakeDescription').value;
            const errorReason = document.getElementById('mistakeErrorReason').value;

            if (!subject || !topic || !description) {
                alert('请填写完整信息');
                return;
            }

            const btn = document.getElementById('addMistakeBtn');
            btn.disabled = true;
            btn.textContent = '添加中...';

            const formData = new FormData();
            formData.append('student_id', studentId);
            formData.append('subject', subject);
            formData.append('topic', topic);
            formData.append('description', description);
            formData.append('error_reason', errorReason);

            try {
                const res = await fetch(`${API_BASE}/mistakes`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` },
                    body: formData
                });

                if (res.ok) {
                    closeAddMistakeModal();
                    await loadMistakesPage();
                    alert('添加成功！');
                } else {
                    const err = await res.json();
                    alert(`添加失败：${err.error || '未知错误'}`);
                }
            } catch (e) {
                console.error('添加错题失败', e);
                alert('添加失败');
            } finally {
                btn.disabled = false;
                btn.textContent = '添加错题';
            }
        }
    </script>
</body>
</html>
